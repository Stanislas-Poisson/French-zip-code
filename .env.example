APP_NAME="French-postal-code"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=frenchpostalcode
DB_USERNAME=frenchpostalcode
DB_PASSWORD=frenchpostalcode

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Nominatim requires an identifying User-Agent (usage policy), put an address where you can be reached.
NOMINATIM_USER_AGENT="French-postal-code"
